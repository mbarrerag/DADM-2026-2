<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7FAFA"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerca de mí"
                android:textColor="#102A2E"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/location_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ubicación pendiente"
                android:textColor="#597277"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/radius_button"
            android:layout_width="70dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/outline_button"
            android:text="5 km"
            android:textAllCaps="false"
            android:textColor="#175B60"
            android:textSize="14sp" />
        <Button
            android:id="@+id/locate_button"
            android:layout_width="98dp"
            android:layout_height="42dp"
            android:background="@drawable/location_button"
            android:text="Ubicarme"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView
            android:id="@+id/filter_all"
            style="@style/FilterChip"
            android:text="Todos" />
        <TextView
            android:id="@+id/filter_health"
            style="@style/FilterChip"
            android:text="Salud" />
        <TextView
            android:id="@+id/filter_tourism"
            style="@style/FilterChip"
            android:text="Turismo" />
        <TextView
            android:id="@+id/filter_parks"
            style="@style/FilterChip"
            android:text="Parques" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#D8E8E7">
        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#EEFFFFFF"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="@string/map_attribution"
            android:textColor="#28535A"
            android:textSize="10sp" />
        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lugares cercanos"
                android:textColor="#102A2E"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/result_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 lugares"
                android:textColor="#597277"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Ubicación pendiente"
            android:textColor="#597277"
            android:textSize="14sp" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/places_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
