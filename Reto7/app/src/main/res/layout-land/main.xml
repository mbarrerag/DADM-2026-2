<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="14dp">

    <co.edu.unal.tictactoe.BoardView
        android:id="@+id/board"
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:background="@drawable/board_panel"
        android:contentDescription="@string/content_board_cell" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/game_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/game_subtitle"
            android:textAllCaps="true"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/game_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/game_title"
            android:textColor="#0F172A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="32dp"
            android:text="@string/first_human"
            android:textColor="#334155"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/action_icons"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/new_game_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/actionBarItemBackground"
                android:contentDescription="@string/new_game"
                android:padding="11dp"
                android:src="@drawable/ic_new_game" />

            <ImageButton
                android:id="@+id/difficulty_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="?android:attr/actionBarItemBackground"
                android:contentDescription="@string/difficulty"
                android:padding="11dp"
                android:src="@drawable/ic_difficulty" />

            <ImageButton
                android:id="@+id/about_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="?android:attr/actionBarItemBackground"
                android:contentDescription="@string/about"
                android:padding="11dp"
                android:src="@drawable/ic_about" />

            <ImageButton
                android:id="@+id/reset_scores_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="?android:attr/actionBarItemBackground"
                android:contentDescription="@string/reset_scores"
                android:padding="11dp"
                android:src="@drawable/ic_reset_scores" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/score_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/human_score"
                style="@style/ScoreText" />

            <TextView
                android:id="@+id/tie_score"
                style="@style/ScoreText" />

            <TextView
                android:id="@+id/computer_score"
                style="@style/ScoreText" />
        </LinearLayout>

        <Button
            android:id="@+id/new_game_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/new_game_button"
            android:text="@string/new_game"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
