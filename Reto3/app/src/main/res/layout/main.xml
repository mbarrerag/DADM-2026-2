<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/game_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="@string/game_subtitle"
        android:textAllCaps="true"
        android:textColor="#2563EB"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/game_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/game_title"
        android:textColor="#0F172A"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/information"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:minHeight="32dp"
        android:text="@string/first_human"
        android:textColor="#334155"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TableLayout
        android:id="@+id/play_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/board_panel"
        android:gravity="center_horizontal">

        <TableRow android:gravity="center_horizontal">
            <Button
                android:id="@+id/one"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/two"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/three"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow android:gravity="center_horizontal">
            <Button
                android:id="@+id/four"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/five"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/six"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow android:gravity="center_horizontal">
            <Button
                android:id="@+id/seven"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/eight"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nine"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:background="@drawable/board_cell"
                android:contentDescription="@string/content_board_cell"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:textSize="44sp"
                android:textStyle="bold" />
        </TableRow>
    </TableLayout>

    <LinearLayout
        android:id="@+id/score_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/human_score"
            style="@style/ScoreText" />

        <TextView
            android:id="@+id/tie_score"
            style="@style/ScoreText" />

        <TextView
            android:id="@+id/computer_score"
            style="@style/ScoreText" />
    </LinearLayout>

    <Button
        android:id="@+id/new_game_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/new_game_button"
        android:text="@string/new_game"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
